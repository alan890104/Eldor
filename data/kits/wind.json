    "gale_weasel": {
      "concept": "三隻鼬輪番出手：「絆」住對手讓牠無法格擋，「斬」出必定暴擊，再以「藥」完成連環，三鐮合一追斬一刀。",
      "mechanic": {
        "name": "三鐮連環",
        "text": "專屬技能分為〔絆〕〔斬〕〔藥〕三式。依 絆 → 斬 → 藥 的順序使用並命中，「連環」逐段推進（顯示在身上）：接在絆之後的〔斬〕必定暴擊；接在斬之後的〔藥〕觸發「三鐮合一」，立刻以剛才的〔斬〕再追擊一次。三式順序錯誤、攻擊落空或被格擋、離場時連環中斷；使用其他技能不影響連環。"
      },
      "trait": {
        "name": "伏鼬",
        "text": "接在〔絆〕之後的〔斬〕傷害 +20%。替換或補位入場時（開場不算），「連環」直接進到〔絆〕。"
      },
      "learnset": [
        { "lv": 1, "id": "gale_weasel_trip" },
        { "lv": 1, "id": "gale_weasel_slash" },
        { "lv": 4, "id": "wind_cutter" },
        { "lv": 8, "id": "gale_weasel_salve" },
        { "lv": 12, "id": "gale_weasel_snare" },
        { "lv": 16, "id": "gale_weasel_chase" },
        { "lv": 18, "id": "gale_weasel_blade_salve" },
        { "lv": 20, "id": "sky_slash" },
        { "lv": 24, "id": "gale_weasel_rend" },
