    "tornado": {
      "concept": "坐鎮風暴中心：暴風圈逐回合擴大，入場的對手被撕扯、後備被颳傷；把最虛弱的對手捲上場，再收束風暴重創全隊。",
      "mechanic": {
        "name": "暴風圈",
        "text": "「暴風圈」0～3 級（顯示在身上）：颶風之眼在場時每回合結束 +1，離場時歸零；每級使颶風之眼的攻擊傷害 +10%。對手的精靈入場時（替換、被捲入、補位）受到「暴風圈 × 4%」最大生命的傷害；每回合結束，對手每隻後備精靈受到「暴風圈 × 2%」最大生命的傷害（不會因此倒下）。「捲入」：把對手生命比例最低的後備精靈拉上場。「無處可躲」：對手沒有後備時，颳向後備的傷害改為颳在場的精靈，「捲入」改為使牠受到入場傷害。"
      },
      "trait": {
        "name": "風眼",
        "text": "入場時「暴風圈」+1。對手的精靈入場後，暴風圈 +1。"
      },
      "learnset": [
        { "lv": 1, "id": "wind_bolt" },
        { "lv": 1, "id": "whirl_in" },
        { "lv": 5, "id": "tornado_squall" },
