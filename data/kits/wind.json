      ],
      "ultimate": "u_dandelion",
      "core": ["dandelion_squall", "dandelion_bloom", "dandelion_drift", "dandelion_sap", "dandelion_puff", "dandelion_glide", "dandelion_sow", "dandelion_puffball"]
    },
    "papercrane": {
      "concept": "一邊攻擊一邊寫信，寫好就乘風離場：接手的隊友收下信，攻擊隨封數變強。沒人可寄時，千羽鶴自己拆信。",
      "mechanic": {
        "name": "信",
        "text": "寫著〔寫信〕的技能使千羽鶴的「信」增加（最多 3 封，顯示在身上）。千羽鶴替換離場或倒下時把信寄出：我方陣地「收信」，在場精靈的攻擊傷害每封 +20%（4 回合，含寄出的那一回合）。沒有後備隊友時，信寫滿 3 封就由千羽鶴自己收下。"
      },
      "trait": {
        "name": "託付",
        "text": "被擊倒時，信多附 1 封（最多 3 封）再寄出。"
      },
      "learnset": [
        { "lv": 1, "id": "papercrane_cut" },
        { "lv": 1, "id": "papercrane_fold" },
        { "lv": 5, "id": "papercrane_relay" },
