        { "lv": 38, "id": "gale_weasel_whirl" },
        { "lv": 45, "id": "gale_weasel_tri_salve" }
      ],
      "ultimate": "u_gale_weasel",
      "core": ["gale_weasel_trip", "gale_weasel_rend", "gale_weasel_tri_salve", "gale_weasel_snare", "gale_weasel_blade_salve", "gale_weasel_slash", "gale_weasel_salve"]
    },
    "aeroth": {
      "concept": "先手搶上高空：有高度時後手打來的攻擊變弱，蓄滿再「天墜」一擊定勝負；被搶先命中就會被擊落。",
      "mechanic": {
        "name": "天穹高度",
        "text": "「高度」0～3（離場歸零）：「掠空」「乘風而上」等技能使高度上升。有高度時，在自身本回合行動之後才命中的攻擊，每層高度傷害 −15%；自身行動前就被攻擊命中則被「擊落」，高度歸零。「天墜」技能消耗全部高度，每層大幅提升威力。"
      },
      "trait": {
        "name": "天穹主宰",
        "text": "入場時展開「疾風」3 回合。以「天墜」技能擊倒對手時，不消耗高度。"
      },
      "learnset": [
        { "lv": 1, "id": "aeroth_skim" },
        { "lv": 1, "id": "aeroth_stoop" },
        { "lv": 4, "id": "wind_cutter" },
