        { "lv": 44, "id": "aeroth_empyrean" },
        { "lv": 50, "id": "aeroth_sunpierce" }
      ],
      "ultimate": "u_aeroth",
      "core": ["aeroth_cloudsplit", "aeroth_skim", "aeroth_updraft", "aeroth_plumes", "aeroth_stoop"]
    },
    "dandelion": {
      "concept": "把絮種撒進對手陣地：站在上面的精靈會被「寄生」，吸來的生命養活我方；打一下就乘風離場，換人也逃不掉。",
      "mechanic": {
        "name": "絮種",
        "text": "寫著〔撒種〕的技能在對手陣地撒下「絮種」（最多 3 層，顯示在對手陣地；5 回合沒有撒種或發芽就散去）。每回合結束時，對手在場的精靈沒有「寄生」的話，1 層絮種在牠身上發芽：「寄生」3 回合（每回合結束失去 4% 最大生命，由我方在場的精靈吸收）。"
      },
      "trait": {
        "name": "隨風而去",
        "text": "替換離場時回復 20% 最大生命，並在對手陣地撒下 1 層絮種。"
      },
      "learnset": [
        { "lv": 1, "id": "dandelion_puff" },
        { "lv": 1, "id": "dandelion_drift" },
        { "lv": 5, "id": "dandelion_sow" },
