        { "lv": 32, "id": "hedgehog_quick_needle" },
        { "lv": 42, "id": "hedgehog_lure_rod" }
      ],
      "ultimate": "u_hedgehog",
      "core": ["hedgehog_needle_storm", "hedgehog_bristle", "volt_claw", "hedgehog_quick_needle", "thunder_punch", "hedgehog_quill_shot", "hedgehog_needle_coat", "hedgehog_static_roll"]
    },
    "ballspark": {
      "concept": "越放電越不穩：攻擊讓「臨界」上升，引爆的威力隨臨界暴增，被擊倒也會炸傷對手。先麻痺讓對手來不及格擋，再一炸換一隻。",
      "mechanic": {
        "name": "臨界",
        "text": "每回合結束時，若球雷核心這回合使用過攻擊技能，「臨界」+1（最多 3 層，顯示在身上，離場歸零）。寫著「引爆」的技能消耗全部臨界，每層獲得技能上寫的威力；使用引爆的回合臨界不會上升。"
      },
      "trait": {
        "name": "不穩定",
        "text": "被攻擊擊倒時爆炸：擊倒者受到其最大生命 10% ＋ 每層「臨界」5% 的傷害。"
      },
      "learnset": [
        { "lv": 1, "id": "spark" },
        { "lv": 1, "id": "ballspark_pop" },
        { "lv": 5, "id": "thunder_wave" },
        { "lv": 9, "id": "ballspark_pressurize" },
        { "lv": 13, "id": "ballspark_plasma_ball" },
        { "lv": 17, "id": "ballspark_overheat_shot" },
