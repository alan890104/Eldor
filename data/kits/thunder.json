{
  "spirits": {
    "stormram": {
      "concept": "把電荷存到爆表：電荷滿了就溢成「過充」，過充的放電威力加倍，但每回合漏電傷身。是穩穩放掉，還是再忍一回合？",
      "mechanic": {
        "name": "過充",
        "text": "電荷已滿 3 層時再獲得電荷，多出來的變成「過充」（最多 3 層，離場歸零）。「放電」類技能消耗全部電荷與過充，過充每層的威力是電荷的 2 倍。代價：回合結束時，每層過充使霆角公羊失去 5% 最大生命（「漏電」）。"
      },
      "trait": {
        "name": "蓄電羊毛",
        "text": "入場時與回合結束時，各獲得 1 層「電荷」（滿了就溢成過充）。"
      },
      "learnset": [
        { "lv": 1, "id": "spark" },
        { "lv": 1, "id": "stormram_discharge" },
        { "lv": 5, "id": "stormram_wool_charge" },
