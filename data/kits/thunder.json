      "ultimate": "u_ballspark",
      "core": ["ballspark_ball_burst", "ballspark_plasma_ball", "ballspark_pop", "spark", "thunder_wave", "ballspark_pressurize", "ballspark_chain_lightning"]
    },
    "stormhorse": {
      "concept": "先電麻對手，再讓馬群追著踩：每次攻擊命中麻痺的對手，就追加一記雷蹄，並把麻痺踩得更久。",
      "mechanic": {
        "name": "雷蹄追擊",
        "text": "雷霆戰駒的攻擊命中「麻痺」的對手後，馬群立刻「追擊」：再以「雷蹄」踏一次（不花靈能，每回合 1 次）。雷蹄命中麻痺的對手時，麻痺延長 1 回合（最多剩 2 回合）。"
      },
      "learnset": [
        { "lv": 1, "id": "stormhorse_thunder_hoof" },
