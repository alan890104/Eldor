        { "lv": 45, "id": "stormram_overload" }
      ],
      "ultimate": "u_stormram",
      "core": ["stormram_discharge", "stormram_horn_cannon", "spark", "stormram_overload", "stormram_fleece_bolt", "stormram_wool_charge", "stormram_arc"]
    },
    "voltarion": {
      "concept": "迅雷不及掩耳：蓄滿 3 層電荷後搶先命中，讓對手整回合落空。以麻痺、先制與雷令奪先機，後手則靠雷鳴與引雷陣蓄勢。",
      "mechanic": {
        "name": "迅雷",
        "text": "有 3 層「電荷」時，若本回合先出手並以雷屬性攻擊命中對手，消耗 3 層電荷使對手本回合的行動無效（「震懾」）。被震懾的精靈獲得「定神」：下一回合不會再被震懾。"
      },
      "learnset": [
        { "lv": 1, "id": "voltarion_thunder_step" },
        { "lv": 1, "id": "voltarion_startle" },
        { "lv": 5, "id": "thunder_wave" },
        { "lv": 10, "id": "voltarion_storm_net" },
        { "lv": 15, "id": "voltarion_summon_storm" },
        { "lv": 18, "id": "arcane_blast" },
        { "lv": 20, "id": "voltarion_smite" },
        { "lv": 22, "id": "voltarion_flash" },
        { "lv": 26, "id": "voltarion_rod_array" },
        { "lv": 30, "id": "voltarion_edict" },
        { "lv": 36, "id": "voltarion_thunderclap" },
        { "lv": 44, "id": "voltarion_sky_cannon" },
        { "lv": 50, "id": "voltarion_myriad" }
      ],
      "ultimate": "u_voltarion",
      "core": ["voltarion_flash", "thunder_wave", "voltarion_thunder_step", "voltarion_myriad", "voltarion_edict", "voltarion_storm_net", "voltarion_startle"]
    },
    "hedgehog": {
      "concept": "背上的「電針」越蓄越多：避雷針把雷擊吸成電針，豎刺也能自己蓄；放針時每根多打一段。專剋雷屬性、保留 1 HP 與替身。",
      "mechanic": {
        "name": "電針",
        "text": "避雷蝟王背上最多插著 5 根「電針」（顯示在身上，離場時消失）。寫著「放針」的技能消耗全部電針，每根使這次連擊多 1 段（每段威力與技能相同）。"
      },
      "trait": {
        "name": "避雷針",
        "text": "吸收雷屬性攻擊（不受傷害也不受附加效果），「電針」+2。"
      },
      "learnset": [
        { "lv": 1, "id": "volt_claw" },
        { "lv": 1, "id": "hedgehog_quill_shot" },
        { "lv": 5, "id": "hedgehog_bristle" },
        { "lv": 9, "id": "thunder_wave" },
        { "lv": 13, "id": "hedgehog_static_roll" },
        { "lv": 17, "id": "thunder_punch" },
        { "lv": 21, "id": "hedgehog_needle_coat" },
