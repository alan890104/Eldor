    },
    "thunderbird": {
      "concept": "風推雲、雷落地：用風屬性技能撥快「雷暴鐘」，在看得見的 2 回合「雷暴」裡以連擊傾瀉落雷；對手只擋得住其中一回合。",
      "mechanic": {
        "name": "雷暴鐘",
        "text": "「雷暴鐘」共 3 格：每回合結束走 1 格，這回合用過風屬性技能再多走 1 格。回合結束時走滿 3 格，鐘歸零、「雷暴」降臨 2 回合（期間鐘不走）。「雷暴」中，雷雲神鳥的連擊技能段數 +2。離場時鐘與雷暴都會消失。"
      },
      "trait": {
        "name": "雷雲",
        "text": "入場時「雷暴鐘」先走 1 格。每次「雷暴」降臨，對手受到其最大生命 8% 的落雷傷害。"
      },
      "learnset": [
        { "lv": 1, "id": "thunderbird_gust_feather" },
        { "lv": 1, "id": "thunderbird_twin_bolt" },
