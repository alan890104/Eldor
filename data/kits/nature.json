{
  "spirits": {
    "elderwood_warden": {
      "concept": "背著古木的守門熊：先「扛木」疊起木盾擋傷害，再「撞木」把整面木盾砸出去。盾留越多，撞得越重。",
      "mechanic": {
        "name": "古木盾",
        "text": "「木盾」是古木熊衛背上的古木：擋下攻擊傷害的護盾，可以疊加（最多為最大生命 50%），3 回合沒有再獲得就會消散。「撞木」攻擊依木盾多寡增加威力，然後消耗全部木盾；這回合先被打掉的木盾也算在內。"
      },
      "trait": {
        "name": "森之庇護",
        "text": "回合結束時，若本回合沒有使用攻擊技能，獲得最大生命 10% 的「木盾」。"
      },
      "learnset": [
        { "lv": 1, "id": "elderwood_warden_paw_swipe" },
        { "lv": 1, "id": "elderwood_warden_shoulder_log" },
        { "lv": 5, "id": "elderwood_warden_log_slam" },
        { "lv": 10, "id": "elderwood_warden_bark_charge" },
        { "lv": 15, "id": "elderwood_warden_roar" },
        { "lv": 20, "id": "thorn_spike" },
        { "lv": 24, "id": "elderwood_warden_ancient_slam" },
        { "lv": 28, "id": "elderwood_warden_guardian_heart" },
        { "lv": 32, "id": "elderwood_warden_moss_layers" },
        { "lv": 36, "id": "elderwood_warden_ward_snare" },
        { "lv": 42, "id": "elderwood_warden_mountain_slam" }
      ],
      "ultimate": "u_elderwood_warden",
      "core": ["elderwood_warden_ancient_slam", "elderwood_warden_shoulder_log", "elderwood_warden_paw_swipe", "elderwood_warden_log_slam", "elderwood_warden_moss_layers"]
    },
    "dreamcap": {
      "concept": "會讓人做夢的毒菇：先用孢子疊毒，毒夠深了就「入夢」讓對手睡上 3 回合，再趁它睡著時補毒、撐傘。",
      "mechanic": {
        "name": "幻孢",
        "text": "幻夢菌后的毒會讓人做夢：寫著「入夢」的技能消耗對手 3 層「中毒」，使它「睡眠」3 回合（一般睡眠為 2 回合）。對手中毒不足 3 層、或無法睡著時沒有效果，也不消耗中毒。"
      },
      "learnset": [
        { "lv": 1, "id": "dreamcap_spore_shot" },
        { "lv": 1, "id": "toxic_spores" },
        { "lv": 5, "id": "dreamcap_dream_dust" },
        { "lv": 10, "id": "dreamcap_rude_awakening" },
