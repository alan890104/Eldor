        { "lv": 32, "id": "dreamcap_miasma" },
        { "lv": 38, "id": "dreamcap_fairy_ring" }
      ],
      "ultimate": "u_dreamcap",
      "core": ["toxic_spores", "dreamcap_dream_cloud", "dreamcap_miasma", "dreamcap_spore_shot", "petal_storm", "dreamcap_dream_dust"]
    },
    "sylvaron": {
      "concept": "先讓對手「枯萎」，再用春雨、甘霖與森域讓雙方回復：自己回血、對手反而掉血。掉的血長成萬葉，化為風暴或靈能。",
      "mechanic": {
        "name": "枯榮",
        "text": "「枯萎」的精靈受到任何回復時（「森域」、吸取、回復技能都算），改為損失等量生命；每這樣損失一次，希爾凡長出 1 片「萬葉」（最多 5 片，離場保留），由專屬技能消耗。對手離場時「枯萎」解除。"
      },
      "trait": {
        "name": "萬葉庇佑",
        "text": "入場時展開「森域」3 回合，並使對手「枯萎」2 回合。每片「萬葉」使自身受到的攻擊傷害 −5%。"
      },
      "learnset": [
        { "lv": 1, "id": "sylvaron_wither_leaf" },
        { "lv": 1, "id": "sylvaron_spring_rain" },
        { "lv": 5, "id": "sylvaron_root_siphon" },
        { "lv": 10, "id": "sylvaron_leaf_flurry" },
        { "lv": 15, "id": "sylvaron_canopy" },
