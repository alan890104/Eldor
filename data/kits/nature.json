        { "lv": 45, "id": "sylvaron_leaf_storm" },
        { "lv": 52, "id": "sylvaron_withering_realm" }
      ],
      "ultimate": "u_sylvaron",
      "core": ["sylvaron_sweet_rain", "sylvaron_leaf_storm", "sylvaron_wither_leaf", "sylvaron_root_siphon", "sylvaron_withering_realm"]
    },
    "acornsquirrel": {
      "concept": "把果實埋起來留著以後吃的松鼠：先埋「藏果」，受傷時自動吃掉回血、力氣更大，越打越有勁；還會「許願」。",
      "mechanic": {
        "name": "藏果",
        "text": "「藏果」是萬果松鼠埋起來、留著以後吃的果實（最多 3 顆，顯示在身上；離場也不會消失）。受到攻擊後生命在 50% 以下時，自動吃掉 1 顆（每回合最多 1 顆）：回復 15% 最大生命，力量 +1 階。"
      },
      "learnset": [
        { "lv": 1, "id": "acornsquirrel_cone_toss" },
        { "lv": 1, "id": "acornsquirrel_bury_acorns" },
        { "lv": 5, "id": "acornsquirrel_quick_bite" },
