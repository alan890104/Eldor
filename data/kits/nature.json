      "ultimate": "u_acornsquirrel",
      "core": ["acornsquirrel_hoard_rush", "acornsquirrel_bury_acorns", "acornsquirrel_quick_bite", "acornsquirrel_cone_toss", "thorn_spike"]
    },
    "leaffrog": {
      "concept": "吹葉笛的蛙：每一曲「笛」都在下回合結束時再響一次，回音打中對手時也把生機吹回自己身上。",
      "mechanic": {
        "name": "回春",
        "text": "寫著「笛」的技能命中後留下「回音」（顯示在身上）：下回合結束時再響一次（威力 50%），森笛蛙王回復等同回音傷害的生命（「回春」）。回音還沒響時再吹「笛」，舊的回音會立刻響起。"
      },
      "trait": {
        "name": "晨露",
        "text": "回音響起的回合結束時，解除自身一種異常狀態。"
      },
      "learnset": [
        { "lv": 1, "id": "aqua_shot" },
        { "lv": 1, "id": "echo_pipe" },
        { "lv": 5, "id": "leaffrog_dew_sip" },
