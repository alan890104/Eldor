        { "lv": 42, "id": "owlarchivist_feather_tome" }
      ],
      "ultimate": "u_owlarchivist",
      "core": ["owlarchivist_decipher", "seal_scroll", "owlarchivist_night_reading", "owlarchivist_moss_bolt", "owlarchivist_quill", "owlarchivist_foreshadow"]
    },
    "banyanelder": {
      "concept": "用氣根纏住對手，氣根每回合自己越長越多：纏得越緊，它越打不動你、你越打越痛。長滿 4 根時絞殺無視格擋。",
      "mechanic": {
        "name": "氣根",
        "text": "「氣根」纏在對手身上（最多 4 根；對手或古榕離場時消失）。每根使它對古榕造成的攻擊傷害 −5%、受到古榕的攻擊傷害 +5%。回合結束時，身上有氣根的對手再長出 1 根；若它本回合格擋，改為掙斷 2 根。"
      },
      "trait": {
        "name": "盤根",
        "text": "不會被強制替換。對手每掙斷 1 根「氣根」，古榕獲得 1 點靈能。"
      },
      "learnset": [
        { "lv": 1, "id": "banyanelder_root_lash" },
        { "lv": 1, "id": "banyanelder_seed_root" },
        { "lv": 5, "id": "banyanelder_root_crush" },
