      "ultimate": "u_leaffrog",
      "core": ["leaffrog_grove_concert", "echo_pipe", "leaffrog_water_pipe", "aqua_shot", "leaffrog_dew_sip"]
    },
    "owlarchivist": {
      "concept": "把對手的招式記在羽毛上：被「看穿」的招式再用就被封印，「封卷」還能直接封住它。封印期間，讀破與夜讀趁機猛攻。",
      "mechanic": {
        "name": "看穿",
        "text": "「看穿」會記下對手的一個技能：它上一個使用的技能；還沒用過技能時，改為它威力最高的攻擊技能（奧義除外；同時只記一個，新的取代舊的；雙方任一離場時消失）。被看穿的技能對書梟造成的傷害 −40%；對手使用它的回合結束時，那個技能被「封印」2 回合，看穿解除。"
      },
      "trait": {
        "name": "記錄",
        "text": "入場時，「看穿」對手的技能。"
      },
      "learnset": [
        { "lv": 1, "id": "owlarchivist_moss_bolt" },
        { "lv": 1, "id": "owlarchivist_record" },
        { "lv": 5, "id": "owlarchivist_quill" },
