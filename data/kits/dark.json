{
  "spirits": {
    "eclipse_batlord": {
      "concept": "咬一口留下「夜吻」，再用超音波逼對手出手：對手打得越兇，傷口湧出的血越多，全被蝠王吸走；倒懸張翼時一滴不漏。",
      "mechanic": {
        "name": "夜吻",
        "text": "月蝕蝠王的〔吻〕技能命中後，對手被「夜吻」3 回合（顯示在對手身上；再次夜吻刷新回合數；雙方任一離場時消失）。被夜吻的對手每次以攻擊命中蝠王，傷口就湧出血來：對手失去等同該次傷害 30% 的生命，蝠王回復等量。"
      },
      "trait": {
        "name": "吸血本能",
        "text": "擊倒被「夜吻」的對手時，回復 20% 最大生命。"
      },
      "learnset": [
        { "lv": 1, "id": "eclipse_batlord_night_kiss" },
        { "lv": 1, "id": "eclipse_batlord_screech" },
        { "lv": 5, "id": "eclipse_batlord_wing_dive" },
        { "lv": 9, "id": "eclipse_batlord_blood_fang" },
        { "lv": 13, "id": "eclipse_batlord_hang" },
        { "lv": 17, "id": "hex" },
        { "lv": 21, "id": "night_slash" },
        { "lv": 25, "id": "eclipse_batlord_eclipse" },
        { "lv": 29, "id": "eclipse_batlord_bloodlust" },
        { "lv": 33, "id": "eclipse_batlord_drink_deep" },
        { "lv": 37, "id": "eclipse_batlord_scatter" },
        { "lv": 41, "id": "eclipse_batlord_blood_moon" }
      ],
      "ultimate": "u_eclipse_batlord",
      "core": ["eclipse_batlord_blood_moon", "eclipse_batlord_hang", "eclipse_batlord_screech", "eclipse_batlord_night_kiss"]
    },
    "soul_lantern": {
      "concept": "伏技化為亮著的冥燈，每回合燒魂、燈亮時詛咒不退；對手不踩燈就被慢慢燒盡，踩了便中咒，時機到了把燈掛到對手身上，雙燈齊燒。",
      "mechanic": {
        "name": "冥燈",
        "text": "冥燈引魂者在場時，我方設置中的伏技就是一盞亮著的「冥燈」：每回合結束時翻開，並以「魂焰」燒灼對手最大生命 5%（對手「詛咒」中改為 10%）。伏技發動或被破壞時，燈就熄滅（掛到對手身上的燈不會）。許多技能在「燈亮著」時效果不同。"
      },
      "trait": {
        "name": "長明",
        "text": "冥燈亮著時，對手的「詛咒」不會減少回合數。"
      },
      "learnset": [
        { "lv": 1, "id": "soul_lantern_wisp" },
        { "lv": 1, "id": "soul_lantern_lure_lamp" },
        { "lv": 5, "id": "hex" },
        { "lv": 9, "id": "soul_lantern_ghost_flame" },
        { "lv": 13, "id": "soul_lantern_lamp_whisper" },
        { "lv": 17, "id": "soul_lantern_seal_lamp" },
        { "lv": 22, "id": "soul_lantern_hang_lamp" },
        { "lv": 26, "id": "soul_lantern_soul_drain" },
        { "lv": 30, "id": "soul_lantern_wraith_step" },
        { "lv": 34, "id": "soul_lantern_karma_fire" },
        { "lv": 38, "id": "soul_lantern_lamp_rest" },
        { "lv": 45, "id": "soul_lantern_thousand_lamps" }
      ],
      "ultimate": "u_soul_lantern",
      "core": ["soul_lantern_hang_lamp", "soul_lantern_lure_lamp", "soul_lantern_ghost_flame", "soul_lantern_wisp"]
    },
    "noxfang": {
      "concept": "以獵痕拉高斬殺線，永夜讓線更高；伏影撲擊反咬、獵殺之牙先制收尾，月蝕之牙把斬殺線翻倍。",
      "mechanic": {
        "name": "獵痕",
        "text": "諾克斯的技能與我方伏技會在對手身上留下「獵痕」（最多 5 層；對手或諾克斯離場時消失）。「斬殺線」= 每層獵痕 6%，「永夜」中再 +10%。諾克斯的攻擊命中後，若對手生命 ≤ 斬殺線，直接將其擊倒（「獵殺」）。"
      },
      "trait": {
        "name": "夜之獵手",
        "text": "入場時展開「永夜」3 回合。我方伏技發動時，對手獲得 1 層「獵痕」。"
      },
      "learnset": [
        { "lv": 1, "id": "noxfang_shadow_fang" },
        { "lv": 1, "id": "noxfang_blood_scent" },
        { "lv": 5, "id": "noxfang_pounce" },
        { "lv": 9, "id": "noxfang_nightfall" },
        { "lv": 13, "id": "noxfang_throat_rend" },
        { "lv": 17, "id": "noxfang_hunt_down" },
        { "lv": 22, "id": "noxfang_shadow_ambush" },
        { "lv": 26, "id": "noxfang_moon_claws" },
        { "lv": 30, "id": "noxfang_bloodmoon_snare" },
        { "lv": 34, "id": "noxfang_moon_howl" },
        { "lv": 38, "id": "noxfang_lunar_rend" },
        { "lv": 45, "id": "noxfang_kill_fang" },
        { "lv": 50, "id": "noxfang_pack_feast" }
      ],
      "ultimate": "u_noxfang",
      "core": ["noxfang_pack_feast", "noxfang_kill_fang", "noxfang_shadow_ambush", "noxfang_shadow_fang"]
    },
    "abyssjelly": {
      "concept": "觸手讓對手麻痺，麻痺的對手每回合被「靈絲」汲走 1 點靈能：放不出奧義、也格擋不起；水母再把吸來的靈能灌進夜潮。",
      "mechanic": {
        "name": "靈絲",
        "text": "「麻痺」中的對手被永夜水母后發光的「靈絲」纏著：每回合結束，若對手還有靈能，汲走 1 點給我方。"
      },
