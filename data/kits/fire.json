    "bellowsbeast": {
      "concept": "鼓風或吃下對手的火焰點燃「火種」，下一個火屬性攻擊就「爆燃」；熔爐爆發把火種燒成兩倍威力。",
      "mechanic": {
        "name": "火種",
        "text": "熔爐鍛獸的「火種」點燃時（顯示在身上），下一個火屬性攻擊「爆燃」：威力 +50%，之後火種熄滅。寫著「鼓風」的技能與特性【引火】會點燃火種。"
      },
      "trait": {
        "name": "引火",
        "text": "受到火屬性攻擊後，點燃「火種」。"
      },
      "learnset": [
