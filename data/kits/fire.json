    "shieldbeetle": {
      "concept": "舉盾、格擋、烙殼守住陣線累積「固守」（越守越硬），再以「破陣」把守下來的回合一口氣衝出去。",
      "mechanic": {
        "name": "固守",
        "text": "赤鐵騎甲格擋或使用秘術、沒有攻擊的回合，回合結束時「固守」+1（最多 3 層，顯示在身上，離場歸零）。每層固守使受到的攻擊傷害 −12%。寫著「破陣」的攻擊消耗全部固守，每層威力提升（數值寫在技能上）。"
      },
      "trait": {
        "name": "騎士之盾",
        "text": "成功「格擋」攻擊時，「固守」+1（加上回合結束的 +1，格擋的回合共 +2）。"
      },
      "learnset": [
        { "lv": 1, "id": "flame_claw" },
        { "lv": 1, "id": "shieldbeetle_raise" },
        { "lv": 5, "id": "shield_bash" },
