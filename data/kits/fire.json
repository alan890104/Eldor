        { "lv": 45, "id": "golem_eternal_forge" }
      ],
      "ultimate": "u_magma_golem",
      "core": ["golem_thousand_hammers", "golem_lava_hammer", "golem_quench", "golem_forge_fist", "golem_cast_strike", "golem_lava_pit", "golem_anvil_stance"]
    },
    "ignisar": {
      "concept": "烈陽與挨打都讓鬃焰更熾：白焰不怕水、蒼焰擋不住。燒到蒼焰就用日冕爆釋放換回靈能，或以奧義加冕、鎖住蒼焰橫掃。",
      "mechanic": {
        "name": "焰色",
        "text": "鬃焰分三色：赤焰 → 白焰 → 蒼焰（以白焰登場，離場時重置）。升溫：「烈陽」中每回合結束、每回合首次受到攻擊時，各升一階。白焰以上：火屬性攻擊不會被「抵抗」，也不受「暴雨」削弱。蒼焰：火屬性攻擊無視「格擋」與護盾，但每回合結束「過熱」，失去 8% 最大生命。"
      },
      "trait": {
        "name": "王焰領域",
        "text": "入場時展開「烈陽」3 回合。烈陽只為王者燃燒：對手的火屬性攻擊打在伊格尼薩身上時，不受烈陽加成。"
      },
      "learnset": [
        { "lv": 1, "id": "ignisar_mane_flare" },
        { "lv": 1, "id": "ignisar_royal_roar" },
        { "lv": 5, "id": "ignisar_white_breath" },
