        { "lv": 40, "id": "pyre_dragoon_armor_break" }
      ],
      "ultimate": "u_pyre_dragoon",
      "core": ["pyre_dragoon_crimson_charge", "pyre_dragoon_tail_dash", "pyre_dragoon_dance", "pyre_dragoon_charge", "flame_claw", "blaze_slash"]
    },
    "pyrewing": {
      "concept": "撲粉、鱗粉幕在對手身上撒下「鱗粉」，再「點燃」一口氣引爆：每層都是穩定的百分比傷害，並必定灼燒。",
      "mechanic": {
        "name": "鱗粉",
        "text": "焰翅蛾后寫著〔撒粉〕的技能在對手身上撒下「鱗粉」（最多 3 層，對手離場時散去）。寫著「點燃」的技能消耗全部鱗粉：每層使對手受到其最大生命的百分比傷害（數值寫在技能上），有鱗粉時並使其「灼燒」。"
      },
      "trait": {
        "name": "火鱗粉",
        "text": "受到武技攻擊時，攻擊者沾上 1 層「鱗粉」。"
      },
      "learnset": [
        { "lv": 1, "id": "ember" },
        { "lv": 1, "id": "pyrewing_dust" },
        { "lv": 5, "id": "pyrewing_ignite" },
