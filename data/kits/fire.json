      ],
      "ultimate": "u_pyrewing",
      "core": ["pyrewing_wildfire", "pyrewing_moth_swarm", "fireball", "pyrewing_ignite", "pyrewing_dust", "ember"]
    },
    "magma_golem": {
      "concept": "用鍛拳、淬火、鐵砧在身上鍛入焰／鋒／重三道紋，再以出爐一擊全部打出：灼燒、必定暴擊、無視格擋。",
      "mechanic": {
        "name": "鍛紋",
        "text": "寫著「鍛入」的技能會在熔岩魔像身上鍛入「紋」，每種最多 1 道：「焰紋」命中後使對手「灼燒」；「鋒紋」必定暴擊；「重紋」無視「格擋」與護盾。「出爐」攻擊帶著所有紋打出，使用後紋清空（被格擋也一樣）。離場時紋會冷卻消失。"
      },
      "trait": {
        "name": "熔岩之軀",
        "text": "受到武技攻擊時，30% 使攻擊者「灼燒」；身上有「焰紋」時必定灼燒。"
      },
      "learnset": [
        { "lv": 1, "id": "golem_forge_fist" },
        { "lv": 1, "id": "golem_quench" },
        { "lv": 5, "id": "golem_cast_strike" },
