{
  "spirits": {
    "pyre_dragoon": {
      "concept": "尾焰衝刺、龍舞提升速度累積「衝勢」，再以衝鋒把全部衝勢化為威力一口氣打出；紅蓮突擊擊倒對手還能帶著衝勢繼續衝。",
      "mechanic": {
        "name": "衝勢",
        "text": "熾焰龍騎的速度提升就是「衝勢」（顯示在身上）：跑得越快，越先出手。寫著「衝鋒」的技能消耗自身全部速度提升，每階使威力提升（數值寫在技能上）。"
      },
      "trait": {
        "name": "龍騎之心",
        "text": "生命首次降到 50% 以下時，速度 +1 階（衝勢 +1；每場一次）。"
      },
      "learnset": [
        { "lv": 1, "id": "flame_claw" },
        { "lv": 1, "id": "pyre_dragoon_tail_dash" },
        { "lv": 5, "id": "pyre_dragoon_charge" },
