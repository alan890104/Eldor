    "grimoire": {
      "mechanic": {
        "name": "抄本",
        "text": "秘典書靈在場時，對手每使用一個技能（奧義、伏技除外），就把它抄進「抄本」成為最新的一頁（最多 3 頁；抄過的移到最新；滿了擠掉最舊的一頁；抄本離場保留）。「複寫」類技能施展抄本中的技能（武技改以魔力計算）；「焚頁」類技能撕掉頁數換取威力。"
      },
      "trait": {
        "name": "記述",
        "text": "入場時，把對手在場精靈上一次使用的技能抄進「抄本」。"
      },
      "concept": "把對手用過的技能抄進抄本：複寫它、倒寫回去反擊，或撕下書頁化為魔力。對手的招式越強，這本書就越可怕。",
      "learnset": [
        { "lv": 1, "id": "arcane_bolt" },
        { "lv": 1, "id": "transcribe" },
        { "lv": 5, "id": "grimoire_page_flare" },
        { "lv": 9, "id": "grimoire_page_ward" },
        { "lv": 13, "id": "grimoire_page_storm" },
