        { "lv": 37, "id": "grimoire_annotate" },
        { "lv": 45, "id": "grimoire_final_chapter" }
      ],
      "ultimate": "u_grimoire",
      "core": ["transcribe", "grimoire_burn_all", "grimoire_final_chapter", "grimoire_page_flare", "grimoire_page_storm"]
    },
    "clockmouse": {
      "mechanic": {
        "name": "發條",
        "text": "機樞鼠王入場時「發條」上滿 3 圈（顯示在身上）。寫著「放條」的攻擊在還有發條時先制 +1，出手後發條 −1；發條用完就「停擺」，放條攻擊不再先制，直到重新上發條。"
      },
      "trait": {
        "name": "上發條",
        "text": "回合結束時，若本回合沒有使用「放條」攻擊，發條 +1 圈（最多 3 圈）。"
      },
      "concept": "上滿發條衝進場：三圈發條就是三次搶先出手的機會，用完再上緊。便宜的收尾手與陷阱鼠夾，專抓換人與殘血。",
      "learnset": [
