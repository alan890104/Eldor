    "relic_blade": {
      "mechanic": {
        "name": "見切",
        "text": "古劍之靈每次「見切」對手，累積 1 層「劍意」（最多 3 層，離場歸零）：① 以格擋擋下攻擊；② 本回合受到攻擊之後，以武技反擊命中（每回合 1 次）。每層劍意使武技暴擊率 +15%；劍意由「一之太刀」與奧義消耗。"
      },
      "trait": {
        "name": "劍意",
        "text": "以格擋擋下攻擊時，立刻以「古刃斬」反擊攻擊者。"
      },
      "concept": "讓對手先出手：格擋與後手反擊累積劍意，劍意越多越容易暴擊；讀對猜拳的每一回合，都在為最後的一之太刀磨刀。",
      "learnset": [
        { "lv": 1, "id": "relic_blade_edge" },
