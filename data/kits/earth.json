        { "lv": 38, "id": "stone_edge" }
      ],
      "trait": { "name": "探脈", "text": "入場時翻開對手設置中的伏技。" },
      "ultimate": "u_digmole",
      "core": ["dig_strike", "digmole_drill_nose", "digmole_crystal_burst", "digmole_upturn", "digmole_rock_bore"]
