    "terragon": {
      "concept": "沙暴裡堆起岩層，讓每一擊最多只削去 25% 生命；時機到了就崩落岩層化為重擊或回復。山崩之後，山又會立起來。",
      "mechanic": { "name": "岩層", "text": "最多 3 層，顯示在身上。泰拉岡有岩層時，受到的每一段攻擊傷害最多為其最大生命的 25%，被削減的那一段會擊碎 1 層岩層。岩層可以「崩落」（全部消耗）換取威力或回復；離場時歸零。" },
      "trait": { "name": "不動磐岳", "text": "入場時展開「沙暴」3 回合並獲得 1 層「岩層」；「沙暴」中每回合結束時再獲得 1 層。不會被強制替換。" },
      "learnset": [
        { "lv": 1, "id": "terragon_shell_ram" },
        { "lv": 1, "id": "terragon_stratify" },
        { "lv": 5, "id": "provoke" },
