    "digmole": {
      "concept": "矮人礦工的好幫手：鑽進地底讓對手撲空，再從腳下「破土」奇襲；撲空的對手連格擋都擋不住。",
      "mechanic": { "name": "破土", "text": "寫著「潛地」的技能在使用的回合鑽進地底（攻擊打不到牠），下一回合「破土」出擊。掘晶鼴王在地底時，對手的攻擊「撲空」的話，下一次破土威力 +50%，並且無視「格擋」。" },
      "learnset": [
        { "lv": 1, "id": "digmole_drill_nose" },
        { "lv": 1, "id": "dig_strike" },
