{
  "spirits": {
    "chime_sprite": {
      "concept": "晨鈴以三音祈禱：攻擊是「鳴」、秘術是「清」、伏技發動是「守」；三音湊齊便「和鳴」，一邊傷敵一邊療癒，越唱越響。",
      "mechanic": { "name": "鈴律", "text": "晨鈴仙使用攻擊技能記下「鳴」、使用秘術記下「清」、自己的伏技發動時記下「守」（顯示在身上，離場清空）。三音湊齊時「和鳴」：清空三音，對手受到其最大生命 12% 的傷害，晨鈴仙回復 12% 最大生命。" },
      "trait": { "name": "清音", "text": "入場時翻開對手設置中的伏技，並在「鈴律」記下「守」。" },
      "learnset": [
        { "lv": 1, "id": "chime_ring" },
        { "lv": 1, "id": "chime_clear_bell" },
        { "lv": 5, "id": "chime_ward_bell" },
