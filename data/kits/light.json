        { "lv": 44, "id": "balance_verdict" }
      ],
      "ultimate": "u_balancescale",
      "core": ["balancescale_judgment", "balancescale_weight", "balancescale_level", "balancescale_scale_ray", "balance_verdict"]
    },
    "griffin": {
      "concept": "聖騎士的坐騎：騎士在鞍上時每一擊都有騎槍追擊；格擋與重擊會把騎士打落，獅鷲就化悲憤為孤翼之怒，再吹號讓騎士歸鞍。",
      "mechanic": { "name": "騎乘", "text": "騎士在鞍上時（「騎乘」），獅鷲的專屬攻擊命中後，騎士以「騎槍」追擊（威力 ×0.5）。獅鷲的攻擊被「格擋」、或一次受到最大生命 25% 以上的攻擊傷害時，騎士「落鞍」。「登鞍」類技能讓騎士回到鞍上；離場時騎士下鞍。" },
      "trait": { "name": "聖騎之誓", "text": "入場時騎士上鞍（「騎乘」）。" },
      "learnset": [
        { "lv": 1, "id": "griffin_lance" },
