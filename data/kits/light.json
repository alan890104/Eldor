      ],
      "ultimate": "u_candledove",
      "core": ["candledove_halo_beam", "candledove_twin_candles", "holy_lance", "holy_ray", "candledove_olive_branch"]
    },
    "prismsnail": {
      "concept": "殼是一扇玫瑰窗：磨出的每一面「稜面」都把魔法折回施術者；武技會敲碎玻璃，但稜面越多，它的虹光也越亮。",
      "mechanic": { "name": "稜面", "text": "聖窗巨蝸的殼上有「稜面」（最多 3 面，顯示在身上，離場歸零）。每面稜面使特性「稜鏡」的反彈再 +10%；受到武技攻擊時，擊碎 1 面稜面。寫著〔稜彩〕的技能依稜面數變強。" },
      "trait": { "name": "稜鏡", "text": "受到魔法攻擊而未倒下時，將傷害的 20% 反彈給攻擊者（每面「稜面」再 +10%）。" },
      "learnset": [
        { "lv": 1, "id": "prismsnail_glint" },
