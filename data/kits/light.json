        { "lv": 46, "id": "chime_crescendo" }
      ],
      "ultimate": "u_chime_sprite",
      "core": ["chime_crescendo", "chime_matins", "chime_ward_bell", "chime_ring", "chime_resonance"]
    },
    "luminael": {
      "concept": "晨星是夜裡最後一顆星、也是第一道光：以「逆光」翻轉行動順序，讓負先制的審判搶先落下；不逆光時就後發制人，懲罰對手每一個不出手的回合。",
      "mechanic": { "name": "逆光", "text": "「逆光」期間行動順序反轉：速度慢的先行動，攻擊技能的先制值正負顛倒（格擋、替換與秘術不變）。露米娜爾的攻擊多為負先制：平時最後出手（昏），逆光中搶先出手（晨）；技能依「先出手」或「後出手」發揮不同效果。" },
      "learnset": [
        { "lv": 1, "id": "luminael_dawn_plume" },
        { "lv": 1, "id": "luminael_dawnlight" },
        { "lv": 5, "id": "luminael_star_lance" },
        { "lv": 9, "id": "luminael_sanctuary" },
        { "lv": 13, "id": "luminael_dusk_judgment" },
        { "lv": 17, "id": "healing_light" },
        { "lv": 22, "id": "luminael_morningstar_verdict" },
        { "lv": 26, "id": "luminael_daybreak" },
        { "lv": 30, "id": "luminael_morningstar_inversion" },
        { "lv": 35, "id": "luminael_meteor" },
        { "lv": 42, "id": "luminael_radiant_cannon" },
        { "lv": 47, "id": "luminael_morningstar_oath" },
        { "lv": 52, "id": "luminael_twin_stars" }
      ],
      "ultimate": "u_luminael",
      "core": ["luminael_morningstar_verdict", "luminael_morningstar_inversion", "luminael_dawn_plume", "luminael_radiant_cannon", "luminael_dawnlight"]
    },
    "candledove": {
      "concept": "聖都鐘樓的和平之鴿：牠在場時，誰的強化都撐不過回合結束；以光幕守住隊伍，再銜著橄欖枝把位置交給同伴。",
      "mechanic": { "name": "和平", "text": "光冠聖鴿在場時，每回合結束，雙方在場精靈的能力提升（正的能力階級）全部消除；能力下降保留。" },
      "learnset": [
        { "lv": 1, "id": "holy_ray" },
        { "lv": 1, "id": "dawn_prayer" },
        { "lv": 5, "id": "wind_cutter" },
