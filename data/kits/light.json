      ],
      "ultimate": "u_prismsnail",
      "core": ["prism_refract", "prismsnail_glass_armor", "prismsnail_mirror", "prismsnail_glint", "prismsnail_rainbow"]
    },
    "balancescale": {
      "concept": "天平一端上升，另一端必然下降：替自己加上砝碼，對手就同樣減輕；秤差越大，裁決越重，最後把兩端歸零一次清算。",
      "mechanic": { "name": "對秤", "text": "公義天秤的專屬技能使自身能力階級上升時，對手在場精靈的同一項能力下降相同的階數。「秤差」＝ 天平的能力階級總和 − 對手的能力階級總和（顯示在身上）；寫著〔裁決〕的技能依秤差變強。" },
      "trait": { "name": "秩序", "text": "自身的能力階級不會被對手降低。入場時，對手力量與魔力中較高的一項 −1 階。" },
      "learnset": [
        { "lv": 1, "id": "balancescale_scale_ray" },
        { "lv": 1, "id": "balancescale_weight" },
        { "lv": 5, "id": "balancescale_equalize" },
